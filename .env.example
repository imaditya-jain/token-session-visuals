# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- Shopify (development store) ---
# Store host, e.g. your-store.myshopify.com
SHOPIFY_STORE_URL=
SHOPIFY_STOREFRONT_API_ACCESS_TOKEN=
# Admin token is used only by scripts/ and server jobs, never by the browser bundle.
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
# Signing secret for incoming Shopify webhooks (the app's client secret). Webhook route fails closed without it.
SHOPIFY_WEBHOOK_SECRET=

# --- Auth (Phase 3) ---
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# --- Database (Phase 3) ---
MONGODB_URI=

# --- Email (Gmail SMTP: use an App Password, not your login password) ---
SMTP_EMAIL=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM_NAME=Fernwood
# Inbox that receives contact-form messages (defaults to SMTP_EMAIL)
CONTACT_INBOX=
# Send our own branded order emails (received / shipped / cancelled). Leave false while Shopify sends its own
# order emails; set true only after turning those off in Shopify (Settings > Notifications), or customers get duplicates.
ORDER_EMAIL_NOTIFICATIONS=false

# --- Error monitoring (Sentry). All optional: with no DSN nothing is sent and no code ships to the browser ---
# Server-side errors (API routes, jobs, server components):
SENTRY_DSN=
# Browser-side errors. Read at BUILD time, so set it in the environment that builds the app. Setting it also
# enables the same-origin /monitoring tunnel and the Sentry build plugin:
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Source-map upload at build (makes production stack traces readable); skipped when no token is set:
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Public site origin used in links inside emails (never taken from request headers). Required in production.
SITE_URL=http://localhost:3000
# Secret for the cron sweeper (Vercel sends it as a Bearer token). Generate: openssl rand -base64 32
CRON_SECRET=

# Optional
LOG_LEVEL=info
