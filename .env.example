# Copy to .env.local (or .env) and fill in. Never commit real values.

# Shopify (development store). Domain looks like your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_API_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# Transactional email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASS=

# MongoDB Atlas (Phase 3)
MONGODB_URI=
# JWT signing secret (Phase 3), 32+ random bytes, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=
